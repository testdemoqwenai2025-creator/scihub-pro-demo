# SciHub Pro - Environment Variables
# Copy this file to .env and fill in your values

# ============ APPLICATION ============
NEXT_PUBLIC_APP_NAME=SciHub Pro
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============ DATABASE (Prisma/PostgreSQL) ============
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/scihub_pro"

# ============ AUTHENTICATION ============
# NextAuth.js / Clerk configuration
# NEXTAUTH_SECRET=your-secret-key-here
# NEXTAUTH_URL=http://localhost:3000

# Optional: OAuth providers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ============ EXTERNAL API KEYS (Optional - many are free without keys) ============

# NCBI E-utilities (optional - for higher rate limits)
# NCBI_API_KEY=your-ncbi-api-key

# CrossRef (no key required for basic usage)
# CROSSREF_MAILTO=your-email@example.com

# OpenAlex (no key required)
# OPENALEX_EMAIL=your-email@example.com

# arXiv (no key required)

# PubChem (no key required)

# ============ AETHEL AI PLATFORM ============
AETHEL_API_URL=http://localhost:8080/api
AETHEL_API_KEY=dev-api-key-for-testing

# ============ STORAGE ============
# Supabase (free tier available)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Cloudflare R2 / S3 compatible storage
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=

# ============ REDIS (optional - for caching) ============
# REDIS_URL=redis://localhost:6379

# ============ ANALYTICS ============
# Next Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ID=

# ============ DEVELOPMENT ============
NODE_ENV=development
DEBUG=scihub:*
