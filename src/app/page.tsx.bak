                </CardHeader>
                <CardContent className="pt-0">
                  <ul className="space-y-3 mb-6">
                    {tier.features.map((feature, j) => (
                      <li key={j} className="flex items-start gap-2 text-sm">
                        <Icons.Check className="w-4 h-4 text-cyan-400 mt-0.5 shrink-0" />
                        <span className={tier.highlighted ? 'text-slate-200' : 'text-slate-400'}>{feature}</span>
                      </li>
                    ))}
                  </ul>
                  <Button 
                    className={`w-full ${tier.highlighted ? 'bg-gradient-to-r from-cyan-500 to-teal-500 hover:from-cyan-400 hover:to-teal-400 text-white border-0' : ''}`}
                    variant={!tier.highlighted ? 'outline' : 'default'}
                    onClick={() => {
                      if (tier.name?.includes('Free')) handlePricingCTA('free')
                      else if (tier.name?.includes('Pro')) handlePricingCTA('pro')
                      else if (tier.name?.includes('Enterprise')) handlePricingCTA('enterprise')
                      else router.push('/subscription')
                    }}
                  >
                    {tier.cta}
                  </Button>
                </CardContent>
              </Card>
            ))}
