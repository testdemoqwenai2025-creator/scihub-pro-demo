                <form onSubmit={handleJoinWaitlist} className="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
                  <Input
                    type="email"
                    placeholder="Enter your email"
                    value={waitlistEmail}
                    onChange={(e) => setWaitlistEmail(e.target.value)}
                    className="bg-slate-800/50 border-slate-700 focus:border-cyan-500 text-white placeholder:text-slate-500"
                  />
                  <Button 
                    type="submit" 
                    disabled={isSubmittingWaitlist || !waitlistEmail.includes('@')}
                    className="bg-gradient-to-r from-cyan-500 to-teal-500 hover:from-cyan-400 hover:to-teal-400 text-white border-0 whitespace-nowrap"
                  >
                    {isSubmittingWaitlist ? '...' : 'Join Waitlist'}
                    <Icons.ArrowRight />
                  </Button>
                </form>
