            </div>
          </div>

          <Separator className="bg-slate-800 mb-8" />

          <div className="flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-slate-500">
            <p>© {new Date().getFullYear()} Endeavor Science (AETH-1). All rights reserved.</p>
            <p>Democratizing Scientific Discovery</p>
          </div>
        </div>
      </footer>

      {/* ============ DEMO MODAL ============ */}
      <Dialog open={showDemoModal} onOpenChange={setShowDemoModal}>
        <DialogContent className="max-w-4xl max-h-[90vh] overflow-y-auto">
          <DialogHeader>
            <DialogTitle className="text-2xl flex items-center gap-3">
              <span className="text-3xl">🎬</span>
              SciHub Pro Platform Demo
            </DialogTitle>
            <DialogDescription>
              See how researchers use SciHub Pro to accelerate their work from discovery to publication.
            </DialogDescription>
          </DialogHeader>
          
          <div className="space-y-6 py-4">
            {DEMO_STEPS.map((step, i) => (
              <div key={i} className="flex items-start gap-4 p-4 rounded-lg bg-muted/50 hover:bg-muted transition-colors">
                <div className="text-4xl">{step.icon}</div>
                <div className="flex-1">
                  <h3 className="font-semibold text-lg">{step.title}</h3>
                  <p className="text-muted-foreground mt-1">{step.description}</p>
                  <div className="flex flex-wrap gap-2 mt-2">
                    {step.features.map((feature, j) => (
                      <Badge key={j} variant="secondary" className="text-xs">{feature}</Badge>
                    ))}
                  </div>
                </div>
                <div className="text-2xl opacity-30">→</div>
              </div>
            ))}
          </div>
          
          <div className="flex flex-col sm:flex-row gap-3 pt-4 border-t">
            <Button variant="outline" onClick={() => setShowDemoModal(false)} className="flex-1">
              Close
            </Button>
            <Button 
              className="flex-1 bg-gradient-to-r from-cyan-500 to-teal-500 hover:from-cyan-400 hover:to-teal-400"
              onClick={() => {
                setShowDemoModal(false)
                router.push('/dashboard?welcome=true')
              }}
            >
              Try It Now →
            </Button>
          </div>
        </DialogContent>
      </Dialog>

      {/* ============ PRICING MODAL ============ */}
      <Dialog open={showPricingModal} onOpenChange={setShowPricingModal}>
        <DialogContent className="max-w-lg">
          <DialogHeader>
            <DialogTitle className="flex items-center gap-2">
              ⭐ Upgrade to {selectedPlan === 'pro' ? 'Pro' : 'Enterprise'}
            </DialogTitle>
            <DialogDescription>
              {selectedPlan === 'pro' 
                ? "Unlock unlimited API access, premium connectors, and advanced features."
                : "Get custom pricing for your institution with dedicated support and SLA guarantees."}
            </DialogDescription>
          </DialogHeader>
          
          <div className="space-y-4 py-4">
            <div className={`p-4 rounded-lg ${selectedPlan === 'pro' ? 'bg-purple-50 dark:bg-purple-950' : 'bg-blue-50 dark:bg-blue-950'}`}>
              <h4 className="font-semibold mb-2">What's included:</h4>
              <ul className="space-y-1 text-sm">
                {selectedPlan === 'pro' ? (
                  <>
                    <li>✓ Unlimited API requests (vs 1,000 on Free)</li>
                    <li>✓ Premium connectors (Scopus, WoS, IEEE)</li>
                    <li>✓ Full-text PDF access via Sci-Hub</li>
                    <li>✓ Bulk export (10,000+ results)</li>
                    <li>✓ Priority email support (24h)</li>
                  </>
                ) : (
                  <>
                    <li>✓ Everything in Pro, plus:</li>
                    <li>✓ Unlimited team members</li>
                    <li>✓ Custom API integrations</li>
                    <li>✓ Dedicated account manager</li>
                    <li>✓ 99.9% uptime SLA guarantee</li>
                    <li>✓ On-premise deployment option</li>
                  </>
                )}
              </ul>
            </div>
            
            <Button 
              className="w-full"
              onClick={() => {
                setShowPricingModal(false)
                router.push('/subscription')
              }}
            >
              View Plans & Sign Up →
            </Button>
          </div>
        </DialogContent>
      </Dialog>
    </div>
  )
}
